        "import functools\n",
        "\n",
        "def function(num, item):\n",
        "    return num + 1\n",
        "\n",
        "password = input(\"Enter your password (integersonly): \")\n",
        "lst = list(map(int, password))\n",
        "\n",
        "magic = functools.reduce(function, lst)\n",
        "result = (lambda x: x % 4 == 0)(magic)\n",
        "\n",
        "if result:\n",
        "    print(\"correct password\")\n",
        "else:\n",
        "    print(\"wrong password\")"
